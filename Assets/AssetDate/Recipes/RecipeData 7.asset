  thoughtsMemo: "\u30A8\u30FC\u30C6\u30EB\u304C\u601D\u3044\u51FA\u3057\u305F\u3068\u3044\u3046\u9375\u306E\u5834\u6240\u3092\u898B\u308B\u3068\u672C\u5F53\u306B\u305D\u3053\u306B\u843D\u3061\u3066\u3044\u3066\u3073\u3063\u304F\u308A\u3060\u3063\u305F\u3002\u3061\u306A\u307F\u306B\u4F55\u306E\u9375\u304B\u306F\u6559\u3048\u3066\u304F\u308C\u306A\u304B\u3063\u305F\u3002"
