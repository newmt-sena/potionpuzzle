  trueEffectMemo: "\u8D64\u304F\u67D3\u307E\u308B\u82B1\u3068\u3001\u74F6\u306E\u4E2D\u306E\u7C89\u3092\u5165\u308C\u3001\u8EFD\u304F\u6DF7\u305C\u308B\u3002\u610F\u8B58\u3092\u970A\u4F53\u3068\u3057\u3066\u98DB\u3070\u3059\u4E8B\u304C\u51FA\u6765\u308B\u3088\u3046\u306B\u306A\u308B\u70BA\u3001\u3061\u3087\u3063\u3068\u3057\u305F\u5075\u5BDF\u7528\u306B\u5411\u3044\u3066\u3044\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u5C11\u3057\u6539\u826F\u3057\u305F\u3089\u3001\u3082\u3063\u3068\u6DF1\u3044\u5834\u6240\u306B\u8E0F\u307F\u8FBC\u3081\u308B\u3088\u3046\u306B\u306A\u3089\u306A\u3044\u3060\u308D\u3046\u304B\uFF1F"
  thoughtsMemo: "\u30DD\u30FC\u30B7\u30E7\u30F3\u3092\u98F2\u3093\u3060\u76F4\u5F8C\u306B\u30A8\u30FC\u30C6\u30EB\u304C\u5012\u308C\u3066\u7126\u3063\u305F\u306E\u306F\u5185\u7DD2\u3060\u3002\u5075\u5BDF\u306B\u4F7F\u3048\u305D\u3046\u3068\u3044\u3046\u90E8\u5206\u306F\u540C\u610F\u3059\u308B\u304C\u9577\u671F\u9593\u4F7F\u3046\u306E\u306F\u30EA\u30B9\u30AF\u304C\u3042\u308B\u304B\u3082\u306A\u3002"
