  effectMemo: "\u821E\u3044\u4E0A\u304C\u308B\u7C89\u3068\u523B\u3093\u3060\uFF3F\uFF3F\uFF3F\u3092\u716E\u8A70\u3081\u3001\u6DF7\u305C\u308B\u3002\u8A66\u3057\u306B\u98F2\u3093\u3060\u5F8C\u3001\u30B3\u30C3\u30D7\u3092\u843D\u3068\u3059\u6570\u79D2\u524D\u306B\u300E\uFF3F\uFF3F\uFF3F\u300F\u304C\u982D\u3092\u3088\u304E\u3063\u305F\u3002\u5148\u3092\u8AAD\u3080\u52B9\u679C\u3068\uFF3F\uFF3F\uFF3F\u52B9\u679C\u306F\u6848\u5916\u7D19\u4E00\u91CD\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u5473\u306F\u672A\u77E5\u6570\u3060\u3063\u305F\u304C\u3001\u500B\u4EBA\u7684\u306B\u306F\u597D\u304D\u306A\u5473\u3060\u3063\u305F\u3002\u6848\u5916\u5408\u3046\u3093\u3060\u306A\u3053\u306E\u7D44\u307F\u5408\u308F\u305B\u306F\u2026\u3002"
  trueEffectMemo: "\u821E\u3044\u4E0A\u304C\u308B\u7C89\u3068\u523B\u3093\u3060\u8338\u3092\u716E\u8A70\u3081\u3001\u6DF7\u305C\u308B\u3002\u8A66\u3057\u306B\u98F2\u3093\u3060\u5F8C\u3001\u30B3\u30C3\u30D7\u3092\u843D\u3068\u3059\u6570\u79D2\u524D\u306B\u300E\u5272\u308C\u308B\u6620\u50CF\u300F\u304C\u982D\u3092\u3088\u304E\u3063\u305F\u3002\u5148\u3092\u8AAD\u3080\u52B9\u679C\u3068\u904B\u3092\u547C\u3073\u8FBC\u3080\u52B9\u679C\u306F\u6848\u5916\u7D19\u4E00\u91CD\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u5473\u306F\u672A\u77E5\u6570\u3060\u3063\u305F\u304C\u3001\u500B\u4EBA\u7684\u306B\u306F\u597D\u304D\u306A\u5473\u3060\u3063\u305F\u3002\u6848\u5916\u5408\u3046\u3093\u3060\u306A\u3053\u306E\u7D44\u307F\u5408\u308F\u305B\u306F\u2026\u3002"
  thoughtsMemo: "\u8A00\u308F\u308C\u305F\u901A\u308A\u3001\u5341\u6570\u79D2\u5F8C\u306B\u672C\u5F53\u306B\u8170\u3092\u673A\u306E\u89D2\u306B\u6253\u3061\u4ED8\u3051\u305F\u3002\u7D50\u69CB\u75DB\u304B\u3063\u305F\u3002"
