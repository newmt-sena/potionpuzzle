  trueEffectMemo: "\u8D64\u3044\u82B1\u3068\u3001\u3042\u306E\u661F\u578B\u306E\u5B9F\u306E\u679C\u6C41\u3092\u6DF7\u305C\u5408\u308F\u305B\u308B\u30022\u3064\u306E\u8272\u304C\u6DF7\u3056\u308A\u5408\u3063\u305F\u3088\u3046\u306A\u8272\u5408\u3044\u3067\u3001\u304B\u306A\u308A\u98F2\u307F\u3084\u3059\u3044\u5473\u306A\u306E\u3082\u7279\u5FB4\u7684\u3002\u6697\u95C7\u3067\u3082\u76EE\u304C\u5229\u304F\u3068\u3044\u3046\u4F7F\u3046\u983B\u5EA6\u304C\u9AD8\u305D\u3046\u306A\u52B9\u679C\u6545\u3001\u305D\u306E\u8FBA\u306F\u304B\u306A\u308A\u3042\u308A\u304C\u305F\u3044\u3002"
  thoughtsMemo: "\u9999\u308A\u3084\u8272\u3001\u5473\u3001\u52B9\u679C\u3002\u3069\u308C\u3092\u3068\u3063\u3066\u3082\u512A\u79C0\u3068\u3044\u3046\u7A00\u306B\u898B\u306A\u3044\u9038\u6750\uFF01\u3061\u3087\u3063\u3068\u523A\u6FC0\u304C\u8DB3\u308A\u306A\u3044\u3088\u3046\u306A\u6C17\u3082\u3059\u308B\u3051\u3069\u3001\u3053\u308C\u306F\u3053\u308C\u3067\u3044\u3044\u304B\u3082\uFF1F"
