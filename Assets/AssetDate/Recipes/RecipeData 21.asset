  effectMemo: "\uFF3F\uFF3F\uFF3F\u3068\uFF3F\uFF3F\uFF3F\u3092\u5165\u308C\u3086\u3063\u304F\u308A\u3068\u716E\u3060\u3057\u3066\u3044\u304F\u3002\u304B\u306A\u308A\u4E0D\u601D\u8B70\u306A\u5473\u304C\u3059\u308B\u3002\u610F\u8B58\u3092\uFF3F\uFF3F\uFF3F\u52B9\u679C\u3092\u5FDC\u7528\u3057\u3001\u4ED6\u4EBA\u306E\uFF3F\uFF3F\uFF3F\u306B\u5165\u308C\u308B\u3088\u3046\u306B\u3057\u3066\u307F\u305F\u2026\u304C\u3001\u81EA\u5206\u3082\u7720\u3063\u3066\u3057\u307E\u3046\u70BA\u3001\u5916\u3067\u4F7F\u3046\u306B\u306F\u5C11\u3005\u30EA\u30B9\u30AF\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
  trueEffectMemo: "\u8594\u8587\u3068\u8338\u3092\u5165\u308C\u3086\u3063\u304F\u308A\u3068\u716E\u3060\u3057\u3066\u3044\u304F\u3002\u304B\u306A\u308A\u4E0D\u601D\u8B70\u306A\u5473\u304C\u3059\u308B\u3002\u610F\u8B58\u3092\u970A\u4F53\u3068\u3057\u3066\u98DB\u3070\u3059\u52B9\u679C\u3092\u5FDC\u7528\u3057\u3001\u4ED6\u4EBA\u306E\u5922\u306E\u4E2D\u306B\u5165\u308C\u308B\u3088\u3046\u306B\u3057\u3066\u307F\u305F\u2026\u304C\u3001\u81EA\u5206\u3082\u7720\u3063\u3066\u3057\u307E\u3046\u70BA\u3001\u5916\u3067\u4F7F\u3046\u306B\u306F\u5C11\u3005\u30EA\u30B9\u30AF\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
  thoughtsMemo: "\u5922\u3092\u8997\u304F\u305F\u3081\u306B\u81EA\u8EAB\u3082\u7720\u308B\u3068\u306F\u2026\u5C11\u3057\u672C\u672B\u8EE2\u5012\u306A\u6C17\u3082\u3059\u308B\u304C\u3001\u307E\u3041\u5922\u3092\u8997\u3051\u308B\u3068\u601D\u3048\u3070\u30D7\u30E9\u30DE\u30A4\u30BC\u30ED\u3060\u308D\u3046\u3002"
